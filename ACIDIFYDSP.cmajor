    bool  modSlideEnabled = false;   // DF: Slide-Pot in Reihe zum 100k-DAC
    float modSlideAmount = 0.0f;     //   tau = 22 + 110*v ms (500k-Poti)
    bool  modSoftAtkEnabled = false; // DF Soft Attack
    float modSoftAtkAmount = 0.25f;  //   tau = 0,5 * 60^v ms (0,5..30, DF-Spanne)
    float64 modOverdrive = 1.0;      // abgeleitet aus modOd*
    float64 modKBoost = 1.0;         // abgeleitet aus modResoBoost
    float ampAttackRamp = 1.0f;
    float ampAttackAlpha = 1.0f;
    // Serien-Totzone Gate->Ton (~4 ms, Whittle-Messung); 0 bei DF-Soft-Attack.
    int   ampGateDelayRemaining = 0;
    float ampStockRiseAlpha = 1.0f;
    float accentVcaRiseAlpha = 0.0f;
    float accentVcaFallAlpha = 0.0f;
    float feedbackHighpassPole = 0.0f;
    float feedbackHighpassGain = 0.0f;
    float meterAlpha = 0.0f;
    float parameterSmoothingAlpha = 1.0f;
    float distortionSmoothingAlpha = 1.0f;
    // K1 entfernt (2.16.1): C23 ist Emitter-Bypass der Antilog-Quelle
    // (Q18/R94), KEINE CV-Glaettung — siehe Hauptschleifen-Kommentar.
    // PHONO (2.13.0): Arbeitspunktverschiebung des Koppel-C bei
    // asymmetrischem Clipping (Blocking-Distortion), tau = 50 ms.
    float phonoBiasAlpha = 0.0f;
    float64 phonoBias = 0.0;
    // PHONO (2.15.0): Slew-Limit der 4558-Klasse (1 V/us laut
    // JRC-Datenblatt; Streuung bis 2,2 V/us bei TIs RC4558) — der
    // Standard-Doppel-OP der japanischen Consumer-Geraete der
    // 80er/90er. Bei ~26 V Rail-Spanne (+-13 V) und Rails-Modell
    // +1,0/-0,65 (1,65 Einheiten) entspricht 1 V/us 38 445
    // Einheiten/s; eine volle Flanke dauert ~26 us.
    float phonoSlewPerSample = 1.0e9f;
    float64 phonoSlewState = 0.0;



    float64 ampB0 = 1.0;
    float64 ampB1 = 0.0;
    float64 ampB2 = 0.0;
    float64 ampA1 = 0.0;
    float64 ampA2 = 0.0;
    float64 ampX1 = 0.0;
    float64 ampX2 = 0.0;
    float64 ampY1 = 0.0;
    float64 ampY2 = 0.0;

    float64 purePrevious = 0.0;

    // Pedal-Referenzpegel der Distortion-Stufe: die Airwindows-Modelle sind
    // auf Vollaussteuerung (+-1) kalibriert, die Stimme liefert nominal den
    // dokumentierten Serien-Peak 0,34552. 1 / 0,34552 hebt das Signal fuer
    // die Zerrmodelle auf Referenzpegel und teilt es danach wieder herunter.
    const float64 pedalGain = 1.0 / 0.34552;
    // Fester Ausgangs-Pad des Mackie-Modells auf seine Clip-Decke
    // (1 - 0.1768 aus dem x^5-Soft-Limiter) — ersetzt den drive-gekoppelten
    // Pad, der den Ausgang mit steigendem Drive leiser machte.
    const float64 mackityOutPad = 1.0 / (1.0 - 0.1768);
    float64 mackHP1 = 0.0;
    float64 mackHP2 = 0.0;
    float64 mackIirAmountA = 0.0;
    float64 mackIirAmountB = 0.0;
    float64 mackAB0 = 1.0;
    float64 mackAB1 = 0.0;
    float64 mackAB2 = 0.0;
    float64 mackAA1 = 0.0;
    float64 mackAA2 = 0.0;
    float64 mackAX1 = 0.0;
    float64 mackAX2 = 0.0;
    float64 mackAY1 = 0.0;
    float64 mackAY2 = 0.0;
    float64 mackBB0 = 1.0;
    float64 mackBB1 = 0.0;
    float64 mackBB2 = 0.0;
    float64 mackBA1 = 0.0;
    float64 mackBA2 = 0.0;
    float64 mackBX1 = 0.0;
    float64 mackBX2 = 0.0;
    float64 mackBY1 = 0.0;
