/*
    ACIDIFY 0.7.2 — analog-modelled 303-class bassline for Amorph.

    MIDI/16-step sequencer -> oscillator -> coupling HP -> four-stage ladder
    -> coupling HP -> accent VCA -> output stage.

    The complete core is run at 4x through the Acidify graph below. Filter
    coefficient mapping, envelope/cutoff mapping, coupling frequencies and
    slide constants are adapted from the MIT-licensed Open303 project:

      Copyright (c) 2009 Robin Schmidt (www.rs-met.com)
      https://github.com/RobinSchmidt/Open303

    The implementation is an original Cmajor port and adaptation for Amorph.
    The optional post stage also ports the signal paths of the MIT-licensed
    Airwindows PurestDrive and Mackity processors. PHONO is a clearly labelled
    generic RIAA/overload model rather than a claim to emulate one specific
    mixer.
*/

processor AcidifyCore
{
    input  event std::midi::Message midiIn;
    input  event float64 transportIn;
    input  event std::timeline::Tempo tempoIn;
    input  event std::timeline::TransportState transportStateIn;
    input  event std::timeline::Position positionIn;
    output stream float<2> out;
    output event float currentStep;
    output event float meterOut;
    output event float effectiveTempo;
    output event float transportRunning;
    output event float hostSyncStatus;

    input event float param1  [[ name: "Tuning",         min: -1.0, max: 1.0,   init: 0.0,   unit: "st" ]];
    input event float param2  [[ name: "Cut Off Freq",   min: 0.0,  max: 1.0,   init: 0.45 ]];
    input event float param3  [[ name: "Resonance",      min: 0.0,  max: 1.0,   init: 0.72 ]];
    input event float param4  [[ name: "Env Mod",        min: 0.0,  max: 1.0,   init: 0.68 ]];
    input event float param5  [[ name: "Decay",          min: 0.0,  max: 1.0,   init: 0.45 ]];
    input event float param6  [[ name: "Accent",         min: 0.0,  max: 1.0,   init: 0.65 ]];
    input event float param7  [[ name: "Waveform",       min: 0.0,  max: 1.0,   init: 0.0,   step: 1.0 ]];
    input event float param8  [[ name: "Volume",         min: -36.0, max: 0.0,  init: -6.0,  unit: "dB" ]];
    input event float param9  [[ name: "Tempo",          min: 40.0, max: 300.0, init: 128.0, step: 0.01, unit: "bpm" ]];
    input event float param10 [[ name: "Run",            min: 0.0,  max: 1.0,   init: 0.0,   step: 1.0 ]];
    input event float param11 [[ name: "Pattern Length", min: 1.0,  max: 16.0,  init: 16.0,  step: 1.0 ]];
    input event float param12 [[ name: "Root Note",      min: 24.0, max: 60.0,  init: 36.0,  step: 1.0 ]];

    input event float param13 [[ name: "Step 01 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param14 [[ name: "Step 02 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param15 [[ name: "Step 03 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param16 [[ name: "Step 04 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param17 [[ name: "Step 05 Pitch", min: 0.0, max: 24.0, init: 12.0, step: 1.0 ]];
    input event float param18 [[ name: "Step 06 Pitch", min: 0.0, max: 24.0, init: 10.0, step: 1.0 ]];
    input event float param19 [[ name: "Step 07 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param20 [[ name: "Step 08 Pitch", min: 0.0, max: 24.0, init: 3.0,  step: 1.0 ]];
    input event float param21 [[ name: "Step 09 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param22 [[ name: "Step 10 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param23 [[ name: "Step 11 Pitch", min: 0.0, max: 24.0, init: 12.0, step: 1.0 ]];
    input event float param24 [[ name: "Step 12 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param25 [[ name: "Step 13 Pitch", min: 0.0, max: 24.0, init: 10.0, step: 1.0 ]];
    input event float param26 [[ name: "Step 14 Pitch", min: 0.0, max: 24.0, init: 5.0,  step: 1.0 ]];
    input event float param27 [[ name: "Step 15 Pitch", min: 0.0, max: 24.0, init: 3.0,  step: 1.0 ]];
    input event float param28 [[ name: "Step 16 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];

    // Packed flags: gate = 1, accent = 2, slide = 4.
    input event float param29 [[ name: "Step 01 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param30 [[ name: "Step 02 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param31 [[ name: "Step 03 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param32 [[ name: "Step 04 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param33 [[ name: "Step 05 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param34 [[ name: "Step 06 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param35 [[ name: "Step 07 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param36 [[ name: "Step 08 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param37 [[ name: "Step 09 Flags", min: 0.0, max: 7.0, init: 0.0, step: 1.0 ]];
    input event float param38 [[ name: "Step 10 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param39 [[ name: "Step 11 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param40 [[ name: "Step 12 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param41 [[ name: "Step 13 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param42 [[ name: "Step 14 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param43 [[ name: "Step 15 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param44 [[ name: "Step 16 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param45 [[ name: "Distortion Enable", min: 0.0, max: 1.0, init: 0.0, step: 1.0 ]];
    input event float param46 [[ name: "Distortion Type",   min: 0.0, max: 2.0, init: 0.0, step: 1.0 ]];
    input event float param47 [[ name: "Distortion Drive",  min: 0.0, max: 1.0, init: 0.35 ]];
    input event float param48 [[ name: "Distortion Mix",    min: 0.0, max: 1.0, init: 1.0 ]];
    input event float param49 [[ name: "Clock Mode",         min: 0.0, max: 1.0, init: 0.0, step: 1.0,
                                 text: "Internal|DAW" ]];
    input event float param50 [[ name: "Swing",              min: 0.0, max: 100.0, init: 0.0, step: 1.0,
                                 unit: "%" ]];

    float tuning = 0.0f;
    float cutoffControl = 0.45f;
    float resonanceControl = 0.72f;
    float envModControl = 0.68f;
    float decayControl = 0.45f;
    float accentControl = 0.65f;
    int waveform = 0;
    float volumeDb = -6.0f;
    bool distortionEnabled = false;
    int distortionType = 0;
    float distortionDrive = 0.35f;
    float distortionMix = 1.0f;
    float tempo = 128.0f;
    float swingControl = 0.0f;
    bool manualRunning = false;
    bool dawSyncEnabled = false;
    bool dawPlaying = false;
    bool hostTempoSeen = false;
    bool hostTransportSeen = false;
    bool hostPositionSeen = false;
    float hostTempo = 128.0f;
    float64 hostQuarterNote = 0.0;
    int amorphTransportSlot = 0;
    int amorphPlaySlot = 0;
    int amorphTempoSlot = 1;
    float64[6] amorphPlaySlotScore;
    float64[6] amorphTempoSlotScore;
    bool dawTickReady = false;
    int64 lastDawTick = 0;
    float64 dawGateOffQuarterNote = 0.0;
    bool dawGateArmed = false;
    int reportedSyncFlags = -1;
    int reportedRunning = -1;
    float reportedTempo = -1.0f;
    int clockReportCountdown = 1;
    int clockReportPeriod = 1;
    int patternLength = 16;
    int rootNote = 36;

    int pitch01 = 0;  int pitch02 = 0;  int pitch03 = 7;  int pitch04 = 0;
    int pitch05 = 12; int pitch06 = 10; int pitch07 = 7;  int pitch08 = 3;
    int pitch09 = 0;  int pitch10 = 0;  int pitch11 = 12; int pitch12 = 7;
    int pitch13 = 10; int pitch14 = 5;  int pitch15 = 3;  int pitch16 = 7;

    int flags01 = 3; int flags02 = 5; int flags03 = 1; int flags04 = 1;
    int flags05 = 3; int flags06 = 5; int flags07 = 1; int flags08 = 1;
    int flags09 = 0; int flags10 = 1; int flags11 = 3; int flags12 = 5;
    int flags13 = 1; int flags14 = 1; int flags15 = 1; int flags16 = 5;

    float64 phase = 0.0;
    float currentFrequency = 65.4064f;
    float targetFrequency = 65.4064f;
    int currentNote = -1;
    bool gateOpen = false;
    bool accented = false;

    float filterEnvelope = 0.0f;
    float filterEnvelopeRC = 0.0f;
    float ampEnvelope = 0.0f;
    float accentCapVoltage = 0.0f;
    float accentVcaRC = 0.0f;

    float feedbackHighpassInput = 0.0f;
    float feedbackHighpassOutput = 0.0f;
    // Koppelnetz nach Stinchcombe: fuenf Gruppen, je ein Pol und eine Nullstelle.
    float64[5] coupleX1;
    float64[5] coupleY1;
    float64[5] coupleB0;
    float64[5] coupleB1;
    float64[5] coupleA1;
    float64[3] fbX1;
    float64[3] fbY1;
    float64[3] fbB0;
    float64[3] fbB1;
    float64[3] fbA1;
    // Die beiden VCA-Summenzweige haben eigene Hochpassecken.
    float64 vcaFiltX1 = 0.0, vcaFiltY1 = 0.0;
    float64 vcaCompX1 = 0.0, vcaCompY1 = 0.0;
    float64 vcaFiltP = 0.0, vcaFiltG = 0.0;
    float64 vcaCompP = 0.0, vcaCompG = 0.0;
    float64 zdfS1 = 0.0;
    float64 zdfS2 = 0.0;
    float64 zdfS3 = 0.0;
    float64 zdfS4 = 0.0;

    float baseCutoff = 780.0f;
    float baseCutoffTarget = 780.0f;
    float envScaler = 3.5f;
    float envScalerTarget = 3.5f;
    float envOffset = 0.32f;
    float envOffsetTarget = 0.32f;
    float resonanceSkewed = 0.0f;
    float resonanceSkewedTarget = 0.0f;
    float normalDecayMs = 563.0f;
    float outputGain = 0.501187f;
    float outputGainTarget = 0.501187f;
    float waveformBlend = 0.0f;
    float smoothedDistortionDrive = 0.35f;
    float smoothedDistortionMix = 1.0f;
    float smoothedDistortionType = 0.0f;
    float smoothedDistortionWet = 0.0f;

    float cachedRate = 0.0f;
    float glideCoeff = 0.0f;
    float filterAttackAlpha = 0.0f;
    float normalDecayCoeff = 0.0f;
    float accentDecayCoeff = 0.0f;
    float ampBodyCoeff = 0.0f;
    float ampReleaseCoeff = 0.0f;
    float ampAccentReleaseCoeff = 0.0f;
    float accentVcaRiseAlpha = 0.0f;
    float accentVcaFallAlpha = 0.0f;
    float feedbackHighpassPole = 0.0f;
    float feedbackHighpassGain = 0.0f;
    float meterAlpha = 0.0f;
    float parameterSmoothingAlpha = 1.0f;
    float distortionSmoothingAlpha = 1.0f;



    float64 ampB0 = 1.0;
    float64 ampB1 = 0.0;
    float64 ampB2 = 0.0;
    float64 ampA1 = 0.0;
    float64 ampA2 = 0.0;
    float64 ampX1 = 0.0;
    float64 ampX2 = 0.0;
    float64 ampY1 = 0.0;
    float64 ampY2 = 0.0;

    float64 purePrevious = 0.0;
    float64 mackHP1 = 0.0;
    float64 mackHP2 = 0.0;
    float64 mackIirAmountA = 0.0;
    float64 mackIirAmountB = 0.0;
    float64 mackAB0 = 1.0;
    float64 mackAB1 = 0.0;
    float64 mackAB2 = 0.0;
    float64 mackAA1 = 0.0;
    float64 mackAA2 = 0.0;
    float64 mackAX1 = 0.0;
    float64 mackAX2 = 0.0;
    float64 mackAY1 = 0.0;
    float64 mackAY2 = 0.0;
    float64 mackBB0 = 1.0;
    float64 mackBB1 = 0.0;
    float64 mackBB2 = 0.0;
    float64 mackBA1 = 0.0;
    float64 mackBA2 = 0.0;
    float64 mackBX1 = 0.0;
    float64 mackBX2 = 0.0;
    float64 mackBY1 = 0.0;
    float64 mackBY2 = 0.0;

    float64 riaaB0 = 1.0;
    float64 riaaB1 = 0.0;
    float64 riaaB2 = 0.0;
    float64 riaaA1 = 0.0;
    float64 riaaA2 = 0.0;
    float64 riaaX1 = 0.0;
    float64 riaaX2 = 0.0;
    float64 riaaY1 = 0.0;
    float64 riaaY2 = 0.0;

    int sequenceCountdown = 0;
    int gateCountdown = 0;
    int sequenceStep = -1;
    int meterCountdown = 1;
    int meterPeriod = 1;
    float meterEnvelope = 0.0f;
    int[128] heldNotes;
    int[128] heldVelocities;
    int heldNoteCount = 0;
    bool modelReady = false;

    float exponentialAlpha (float hz, float sampleRate)
    {
        let safeHz = clamp (hz, 0.001f, sampleRate * 0.45f);
        return 1.0f - float (exp (-float64 (twoPi) * float64 (safeHz / sampleRate)));
    }

    float timeCoefficient (float milliseconds, float sampleRate)
    {
        let seconds = max (milliseconds * 0.001f, 0.000001f);
        return float (exp (-1.0 / float64 (seconds * sampleRate)));
    }

    float midiFrequency (int note)
    {
        let bounded = clamp (note, 0, 127);
        let base = float (std::notes::noteToFrequency (bounded));
        let fine = float (pow (2.0, float64 (tuning / 12.0f)));
        return base * fine;
    }

    float polyBlep (float t, float dt)
    {
        if (dt <= 0.0f)
            return 0.0f;

        if (t < dt)
        {
            let x = t / dt;
            return x + x - x * x - 1.0f;
        }

        if (t > 1.0f - dt)
        {
            let x = (t - 1.0f) / dt;
            return x * x + x + x + 1.0f;
        }

        return 0.0f;
    }

    float softClip (float x)
    {
        return float (tanh (float64 (x)));
    }

    // Nur noch der 200-Hz-Entklicker fuer die VCA-Steuerspannung. Allpass,
    // Notch und Hochpass des gebuendelten Open303-Ausgangsnetzes sind durch
    // updateCouplingCoefficients ersetzt.
    void updateOutputNetworkCoefficients (float sampleRate)
    {
        let rate = max (float64 (sampleRate), 1.0);

        // VCA-Steuerglaettung aus der Schaltung: Q32 laedt C42 = 1 uF ueber
        // R132 = 100 Ohm. tau = 100 us -> 1591,5 Hz, einpolig.
        // Open303 stand hier mit einem 200-Hz-Butterworth zweiter Ordnung —
        // ein Entklicker als Platzhalter fuer genau dieses RC-Glied, rund
        // achtfach zu langsam und von falscher Ordnung.
        ampB0 = 1.0 - exp (-float64 (twoPi) * 1591.5 / rate);
        ampA1 = -(1.0 - ampB0);
        ampB1 = 0.0;
        ampB2 = 0.0;
        ampA2 = 0.0;
    }

    void updateMackityCoefficients (float sampleRate)
    {
        let rate = max (float64 (sampleRate), 1.0);
        const float64 referenceRate = 44.1 * 1000.0;
        let overallScale = rate / referenceRate;
        mackIirAmountA = 0.001860867 / overallScale;
        mackIirAmountB = 0.000287496 / overallScale;
        let cutoff = min (19160.0, rate * 0.45);
        let k = tan (float64 (pi) * cutoff / rate);

        let normA = 1.0 / (1.0 + k / 0.431684981684982 + k * k);
        mackAB0 = k * k * normA;
        mackAB1 = 2.0 * mackAB0;
        mackAB2 = mackAB0;
        mackAA1 = 2.0 * (k * k - 1.0) * normA;
        mackAA2 = (1.0 - k / 0.431684981684982 + k * k) * normA;

        let normB = 1.0 / (1.0 + k / 1.1582298 + k * k);
        mackBB0 = k * k * normB;
        mackBB1 = 2.0 * mackBB0;
        mackBB2 = mackBB0;
        mackBA1 = 2.0 * (k * k - 1.0) * normB;
        mackBA2 = (1.0 - k / 1.1582298 + k * k) * normB;
    }

    void updateRiaaCoefficients (float sampleRate)
    {
        let rate = max (float64 (sampleRate), 1.0);
        let bilinear = 2.0 * rate;
        let t1 = 0.003180;
        let t2 = 0.000318;
        let t3 = 0.000075;
        let p1 = bilinear * t1;
        let z2 = bilinear * t2;
        let p3 = bilinear * t3;

        let d0 = (1.0 + p1) * (1.0 + p3);
        let d1 = 2.0 * (1.0 - p1 * p3);
        let d2 = (1.0 - p1) * (1.0 - p3);

        // Normalise the standard 3180/318/75 us playback curve at 1 kHz.
        let referenceW = float64 (twoPi) * 1000.0;
        let referenceMagnitude = sqrt (1.0 + referenceW * referenceW * t2 * t2)
                               / sqrt ((1.0 + referenceW * referenceW * t1 * t1)
                                     * (1.0 + referenceW * referenceW * t3 * t3));
        let normalise = 1.0 / max (referenceMagnitude, 1.0e-12);
        riaaB0 = normalise * (1.0 + z2) / d0;
        riaaB1 = normalise * 2.0 / d0;
        riaaB2 = normalise * (1.0 - z2) / d0;
        riaaA1 = d1 / d0;
        riaaA2 = d2 / d0;
    }

    // Koppelnetz aus Stinchcombes vollstaendiger Uebertragungsfunktion
    // (timstinchcombe.co.uk, „A Comprehensive TB-303 Diode Ladder Filter Model"):
    //
    //   H(s) = 1.06 s^3 (s+109.9)(s+34.0)(s+7.41)
    //          / [ L(s)(s+97.5)(s+38.5)(s+4.45)(s+578.1)(s+20.0)(s+7.41)
    //              + 18.7 k s^4 (s+46.5)(s+4.40) ]
    //
    // Bei k = 0 faellt der Kern L(s) heraus und es bleibt genau das Koppelnetz:
    //
    //   C(s) = 1.06 s^3 (s+109.9)(s+34.0)
    //          / [(s+97.5)(s+38.5)(s+4.45)(s+578.1)(s+20.0)]
    //
    // Fuenf Pole und fuenf Nullstellen — Stinchcombes „basically five sets of
    // these" Koppelkondensatoren, eine Gruppe je Abschnitt. Ersetzt das
    // gebuendelte Open303-Netz aus Allpass 14,008 Hz, Hochpass 24,167 Hz und
    // Notch 7,5164 Hz. Der Notch war der groesste Einzelfehler im Frequenzgang:
    // er lag bei 8 Hz 21 dB unter dem hergeleiteten Netz.
    void updateCouplingCoefficients (float sampleRate)
    {
        let K = 2.0 * max (float64 (sampleRate), 1.0);   // bilineare Transformation
        // Paarung beliebig, das Produkt ist dasselbe; hier nach Groesse sortiert.
        float64[5] zeros = (0.0, 0.0, 0.0, 109.9, 34.0);
        float64[5] poles = (4.45, 20.0, 38.5, 578.1, 97.5);

        for (wrap<5> i)
        {
            let a = zeros[i];
            let b = poles[i];
            let n = 1.0 / (K + b);
            coupleB0[i] = (K + a) * n;
            coupleB1[i] = (a - K) * n;
            coupleA1[i] = (b - K) * n;
        }
        // Durchlassverstaerkung 1.06 auf die erste Stufe.
        coupleB0[0] *= 1.06;
        coupleB1[0] *= 1.06;

        // Rueckkopplungspfad, aus H(s) herausgerechnet:
        //   Bfb(s) = (18.7/1.06) k s (s+46.5)(s+4.40)
        //            / [(s+109.9)(s+34.0)(s+7.41)]
        float64[3] fz = (0.0, 46.5, 4.40);
        float64[3] fp = (109.9, 34.0, 7.41);
        for (wrap<3> i)
        {
            let n = 1.0 / (K + fp[i]);
            fbB0[i] = (K + fz[i]) * n;
            fbB1[i] = (fz[i] - K) * n;
            fbA1[i] = (fp[i] - K) * n;
        }
    }




    float processAmpSmoother (float signal)
    {
        let x = float64 (signal);
        let y = ampB0 * x + ampB1 * ampX1 + ampB2 * ampX2
              - ampA1 * ampY1 - ampA2 * ampY2;
        ampX2 = ampX1;
        ampX1 = x;
        ampY2 = ampY1;
        ampY1 = y;
        return float (y);
    }

    float processPurestDrive (float signal, float drive)
    {
        let x = float64 (signal);
        let shaped = sin (x);
        let apply = min (1.0, 0.5 * abs (purePrevious + shaped) * float64 (drive));
        let driven = x * (1.0 - apply) + shaped * apply;
        purePrevious = sin (x);
        return float (driven);
    }

    float processMackity (float signal, float drive)
    {
        let macroGain = 1.0 + 9.0 * float64 (drive);
        let inputTrim = macroGain * macroGain;
        var x = float64 (signal);

        mackHP1 = mackHP1 * (1.0 - mackIirAmountA) + x * mackIirAmountA;
        x -= mackHP1;
        x *= inputTrim;

        let a = mackAB0 * x + mackAB1 * mackAX1 + mackAB2 * mackAX2
              - mackAA1 * mackAY1 - mackAA2 * mackAY2;
        mackAX2 = mackAX1;
        mackAX1 = x;
        mackAY2 = mackAY1;
        mackAY1 = a;
        x = clamp (a, -1.0, 1.0);
        x -= x * x * x * x * x * 0.1768;

        let b = mackBB0 * x + mackBB1 * mackBX1 + mackBB2 * mackBX2
              - mackBA1 * mackBY1 - mackBA2 * mackBY2;
        mackBX2 = mackBX1;
        mackBX1 = x;
        mackBY2 = mackBY1;
        mackBY1 = b;
        x = b;

        mackHP2 = mackHP2 * (1.0 - mackIirAmountB) + x * mackIirAmountB;
        x -= mackHP2;

        // One macro control replaces Mackity's separate trim and pad controls.
        return float (x / macroGain);
    }

    float processPhono (float signal, float drive)
    {
        let preGain = pow (10.0, 2.0 * float64 (drive));
        let overloaded = tanh (float64 (signal) * preGain);
        let colored = riaaB0 * overloaded + riaaB1 * riaaX1 + riaaB2 * riaaX2
                    - riaaA1 * riaaY1 - riaaA2 * riaaY2;
        riaaX2 = riaaX1;
        riaaX1 = overloaded;
        riaaY2 = riaaY1;
        riaaY1 = colored;
        return softClip (float (colored * 0.18));
    }

    float processDistortion (float signal)
    {
        let pure = processPurestDrive (signal, smoothedDistortionDrive);
        let mackie = processMackity (signal, smoothedDistortionDrive);
        let phono = processPhono (signal, smoothedDistortionDrive);
        if (smoothedDistortionWet <= 0.000001f)
            return signal;

        let type = clamp (smoothedDistortionType, 0.0f, 2.0f);
        let wet = type <= 1.0f
                ? pure + (mackie - pure) * type
                : mackie + (phono - mackie) * (type - 1.0f);
        return signal + (wet - signal) * smoothedDistortionWet;
    }

    float processAccentSweep (float source, float sampleRate)
    {
        // Ideal-diode nodal model of the stock 47k + dual 50k resonance pot
        // + 100k summing resistor + 1uF accent-sweep capacitor network.
        //
        // VR4 ist ein duales 50-k-Poti, nicht 100 k. Zwei unabhaengige Quellen:
        // Whittles Devil-Fish-Handbuch ueber das Originalteil — „The Resonance
        // pot is a dual 50k pot, with a linear taper, which is 'B' ... So
        // '50KB' is the label of the original and the replacement pots" — und
        // die x0xb0x-Stueckliste („50K B (linear) dual potentiometer 1 VR4").
        // Die 100-k-Angabe stand nur auf Whittles 303-unique-Seite und ist
        // damit der Ausreisser gegen seinen eigenen ausfuehrlicheren Text.
        //
        // Der Kondensator laedt ueber den Potiabschnitt, der Wert sitzt also
        // direkt in der Ladezeitkonstante: 1,28x…1,56x schneller ueber den
        // Reglerweg, und der Endwert steigt, weil nur das Poti skaliert und
        // die 47 k und der Summenwiderstand fest bleiben.
        let potPosition = clamp (resonanceSkewed, 0.0f, 1.0f);
        let rAW = max (0.001f, 50.0f * potPosition);
        let rWB = max (0.001f, 50.0f * (1.0f - potPosition));
        let gSource = 1.0f / 47.0f;
        let gAW = 1.0f / rAW;
        let gWB = 1.0f / rWB;
        let gMix = 1.0f / 100.0f;
        let a = gSource + gAW;
        let d = gAW + gWB + gMix;
        let determinant = max (a * d - gAW * gAW, 0.0000001f);
        let positiveSource = max (source, 0.0f);
        let nodeAOn = (gSource * positiveSource * d + gAW * gWB * accentCapVoltage)
                    / determinant;
        var wiper = 0.0f;

        if (positiveSource > 0.0f && nodeAOn <= positiveSource)
        {
            wiper = (a * gWB * accentCapVoltage
                    + gAW * gSource * positiveSource) / determinant;
        }
        else
        {
            wiper = accentCapVoltage * gWB / (gWB + gMix);
        }

        let capacitorCurrent = (wiper - accentCapVoltage) * gWB;
        accentCapVoltage += capacitorCurrent * (1000.0f / max (sampleRate, 1.0f));
        accentCapVoltage = clamp (accentCapVoltage, 0.0f, 2.0f);
        return max (wiper, 0.0f);
    }

    int getPitch (int index)
    {
        if (index == 0)  return pitch01;
        if (index == 1)  return pitch02;
        if (index == 2)  return pitch03;
        if (index == 3)  return pitch04;
        if (index == 4)  return pitch05;
        if (index == 5)  return pitch06;
        if (index == 6)  return pitch07;
        if (index == 7)  return pitch08;
        if (index == 8)  return pitch09;
        if (index == 9)  return pitch10;
        if (index == 10) return pitch11;
        if (index == 11) return pitch12;
        if (index == 12) return pitch13;
        if (index == 13) return pitch14;
        if (index == 14) return pitch15;
        return pitch16;
    }

    int getFlags (int index)
    {
        if (index == 0)  return flags01;
        if (index == 1)  return flags02;
        if (index == 2)  return flags03;
        if (index == 3)  return flags04;
        if (index == 4)  return flags05;
        if (index == 5)  return flags06;
        if (index == 6)  return flags07;
        if (index == 7)  return flags08;
        if (index == 8)  return flags09;
        if (index == 9)  return flags10;
        if (index == 10) return flags11;
        if (index == 11) return flags12;
        if (index == 12) return flags13;
        if (index == 13) return flags14;
        if (index == 14) return flags15;
        return flags16;
    }

    void updateFilterMapping()
    {
        // Cutoff- und Env-Mod-Abbildung aus der Schaltung statt aus sieben
        // Open303-Polynomkoeffizienten.
        //
        // Obergrenze belegt: Whittle, Devil-Fish-Handbuch, Versionsnotiz 2.1C —
        // die maximale resonante Filterfrequenz des Mods ist 5 kHz und damit
        // „an octave above the standard frequency of the TB-303". Serienstand
        // also 2500 Hz. Das ist genau die Groesse, die der Modellparameter
        // seit dem Wegfall von peakToParameter fuehrt.
        //
        // Spanne: Cutoff und Env Mod speisen den Steuerknoten ueber IDENTISCHE
        // Netze — VR3 = 50 k mit R47 = 10 k, VR5 = 50 k mit R61 = 10 k. Beide
        // Wege haben damit dasselbe Gewicht, also dieselbe Spanne in Oktaven.
        // Drei Oktaven unter 2500 Hz sind 312,5 Hz; Open303s gefittetes
        // Minimum von 313,8 Hz liegt 0,4 % daneben und stuetzt den Wert.
        const float highCutoff = 2500.0f;
        const float octaves = 3.0f;

        let c = clamp (cutoffControl, 0.0f, 1.0f);
        let e = clamp (envModControl, 0.0f, 1.0f);

        baseCutoffTarget = highCutoff * float (pow (2.0, float64 (octaves * (c - 1.0f))));

        // Env Mod null heisst KEINE Modulation. Open303 lieferte hier 0,864
        // statt 0 und brauchte deshalb envOffset als Gegengewicht — eine
        // Restmodulation, fuer die es in der Schaltung kein Bauteil gibt.
        envScalerTarget = octaves * e;
        envOffsetTarget = 0.0f;
    }

    void updateResonanceMapping()
    {
        // VR4 ist im Schaltplan ein 50-k-Poti mit B-Kennlinie, also linear.
        // Die gefuehlte Kruemmung entsteht in der Schaltung, nicht am Regler.
        // resonanceSkewed ist damit die mechanische Schleiferstellung — genau
        // das, was processAccentSweep als Potiposition braucht.
        resonanceSkewedTarget = clamp (resonanceControl, 0.0f, 1.0f);
    }

    void updateDecayMapping()
    {
        // Schaltplan, ENV-Block: die Kurve ist mit „10 V = 100 %" am Anfang und
        // „10 %" bei T beschriftet, dazu „DECAY VR MAX T = 2.5 sec, MIN T = 200 ms".
        // T ist damit die Zeit bis auf ein Zehntel, nicht die Zeitkonstante —
        // tau = T / ln(10). VR6 ist ein 1-M-Log-Poti, die Kennlinie bleibt
        // exponentiell.
        //
        // Der bisherige Wert setzte T direkt als tau ein und lief damit am
        // kurzen Ende 2,3-fach zu lang (461 ms statt 200 ms bis 10 %).
        let tenPercentMs = 200.0f * float (pow (12.5, float64 (clamp (decayControl, 0.0f, 1.0f))));
        normalDecayMs = tenPercentMs / float (log (10.0));
        cachedRate = 0.0f;
    }

    void updateRateConstants (float sampleRate)
    {
        cachedRate = sampleRate;
        // Slide aus der Schaltung statt aus Open303. Whittle, Devil-Fish-Handbuch
        // S. 16, ueber den Serienstand: „The usual rather fast slide of a TB-303
        // is caused by the 100K resistance of the DAC feeding a 0.22uF
        // capacitor." tau = 100 k * 0,22 uF = 22 ms. Open303 stand hier mit
        // 12 ms (60 ms mal 0,2), einem Fit.
        glideCoeff = timeCoefficient (22.0f, sampleRate);
        // MEG-Attack aus der Schaltung: D37 in Reihe mit R152 = 100 Ohm laedt
        // C62 = 1 uF. tau = 100 us. Der Knoten ist im Plan eindeutig gezeichnet
        // (R152 -> Basisknoten von Q40, C62 von dort gegen Masse), verfolgt mit
        // tools/bench/nettrace.py. C62 = 1 uF bestaetigt zugleich die
        // Kondensatorannahme, aus der der Decay-Bereich hergeleitet wurde.
        // Open303 stand hier mit 3 ms, also 30-fach zu langsam.
        filterAttackAlpha = 1.0f - timeCoefficient (0.1f, sampleRate);
        normalDecayCoeff = timeCoefficient (normalDecayMs, sampleRate);
        // Accent-Decay: dieselbe Zahl aus derselben Zeichnung wie das Minimum
        // des normalen Decay — also ebenfalls eine 10-%-Zeit, nicht tau.
        // Bestaetigt aus Bauteilwerten: VR6 ist als Rheostat gegen Masse ueber
        // IC12 (4066) geschaltet (mit tools/bench/nettrace.py verfolgt), und der
        // Bereich 200 ms … 2,5 s ist mit C62 = 1 uF nur unter der 10-%-Lesart
        // erreichbar — sie verlangt 86,9 k … 1085,7 k, also 998,9 k Spanne bei
        // VR6 = 1 M und 86,9 k fest (ENV-Stueckliste: R138 68k + 22k = 90k).
        // Die tau-Lesart braeuchte 2300 k Spanne, die VR6 nicht hat.
        accentDecayCoeff = timeCoefficient (200.0f / float (log (10.0)), sampleRate);
        // VCA-Huellkurve aus der Schaltung: C42 = 1 uF laedt ueber R123 = 1,5 M
        // nach +12 V; Q31 ist ein PNP, steigende Basisspannung sperrt ihn, das
        // Aufladen IST also der Decay. tau = 1,5 M * 1 uF = 1500 ms.
        // Open303 stand hier mit 1230 ms, einem Fit.
        ampBodyCoeff = timeCoefficient (1500.0f, sampleRate);
        // Verfolgt: An C42 = 1 uF haengen nur R123 = 1,5 M nach +12 V,
        // R132 = 100 Ohm von Q32 und die Basis von Q31 (PNP). Beim Gate-Off
        // sperrt Q32 — es gibt KEINEN eigenen Entladepfad. Der VCA schliesst,
        // sobald die Basis von Q31 durch das Aufladen ueber die Abschaltschwelle
        // gelaufen ist:
        //   t = -tau * ln(1 - Vth/12)   mit tau = 1,5 s
        //   Vth = 0,4 V -> 51 ms | 0,6 V -> 77 ms | 0,8 V -> 104 ms
        // Open303 stand hier mit 1 ms — das ist unterhalb dessen, was die
        // Schaltung ueberhaupt kann. 77 ms ist der Wert fuer die uebliche
        // Silizium-Schwelle; der Arbeitspunkt von Q31 ist nicht bestimmt,
        // die Spanne 51..104 ms deshalb die belegte Grenze.
        ampReleaseCoeff = timeCoefficient (77.0f, sampleRate);
        ampAccentReleaseCoeff = timeCoefficient (77.0f, sampleRate);
        // 47k * 0.033uF RC between the accent switch and VCA summing node.
        // Accent-Netz am VCA, aus dem Plan gelesen: D27 (1N4148) in Reihe mit
        // R120 = 22 k laedt C36 = 33 nF; R119 = 47 k liegt parallel dazu an der
        // Ausgangsstufe. Die Diode macht das Netz ASYMMETRISCH:
        //   laden  ueber 22 k * 33 nF = 726 us   -> 219,24 Hz
        //   fallen ueber 47 k * 33 nF = 1,551 ms -> 102,62 Hz
        // Bisher stand hier ein einziger, symmetrischer Wert von 102,616 Hz.
        // Die 47 k / 33 nF wurden zuvor als „R26/C26" gefuehrt — gleiche Werte,
        // die Bezeichner der TB-303-Zeichnung sind R119/C36.
        //
        // Einschraenkung: R119 fuehrt an die OTA-Ausgangsstufe, nicht gegen
        // Masse; die Fallzeitkonstante ist damit eine Naeherung erster Ordnung.
        accentVcaRiseAlpha = exponentialAlpha (219.24f, sampleRate);
        accentVcaFallAlpha = exponentialAlpha (102.616f, sampleRate);
        feedbackHighpassPole = float (exp (-float64 (twoPi) * 150.0 / float64 (sampleRate)));
        feedbackHighpassGain = 0.5f * (1.0f + feedbackHighpassPole);
        meterAlpha = 1.0f - timeCoefficient (12.0f, sampleRate);
        parameterSmoothingAlpha = 1.0f - timeCoefficient (5.0f, sampleRate);
        distortionSmoothingAlpha = 1.0f - timeCoefficient (20.0f, sampleRate);
        updateOutputNetworkCoefficients (sampleRate);
        updateCouplingCoefficients (sampleRate);
        updateVcaBranchCoefficients (sampleRate);
        updateMackityCoefficients (sampleRate);
        updateRiaaCoefficients (sampleRate);
        meterPeriod = max (1, int (sampleRate * 0.03f));
        meterCountdown = min (meterCountdown, meterPeriod);
        clockReportPeriod = max (1, int (sampleRate * 0.05f));
        clockReportCountdown = min (clockReportCountdown, clockReportPeriod);
    }

    void initialiseModel (float sampleRate)
    {
        updateFilterMapping();
        updateResonanceMapping();
        updateDecayMapping();
        outputGainTarget = float (std::levels::dBtoGain (float64 (volumeDb)));
        updateRateConstants (sampleRate);
        baseCutoff = baseCutoffTarget;
        envScaler = envScalerTarget;
        envOffset = envOffsetTarget;
        resonanceSkewed = resonanceSkewedTarget;
        outputGain = outputGainTarget;
        waveformBlend = float (waveform);
        smoothedDistortionDrive = distortionDrive;
        smoothedDistortionMix = distortionMix;
        smoothedDistortionType = float (distortionType);
        smoothedDistortionWet = distortionEnabled ? distortionMix : 0.0f;
        modelReady = true;
    }

    void smoothParameters()
    {
        baseCutoff += parameterSmoothingAlpha * (baseCutoffTarget - baseCutoff);
        envScaler += parameterSmoothingAlpha * (envScalerTarget - envScaler);
        envOffset += parameterSmoothingAlpha * (envOffsetTarget - envOffset);
        resonanceSkewed += parameterSmoothingAlpha * (resonanceSkewedTarget - resonanceSkewed);
        outputGain += parameterSmoothingAlpha * (outputGainTarget - outputGain);
        waveformBlend += parameterSmoothingAlpha * (float (waveform) - waveformBlend);
        smoothedDistortionDrive += parameterSmoothingAlpha
                                 * (distortionDrive - smoothedDistortionDrive);
        smoothedDistortionMix += parameterSmoothingAlpha
                               * (distortionMix - smoothedDistortionMix);
        smoothedDistortionType += distortionSmoothingAlpha
                                * (float (distortionType) - smoothedDistortionType);
        let wetTarget = distortionEnabled ? smoothedDistortionMix : 0.0f;
        smoothedDistortionWet += distortionSmoothingAlpha
                              * (wetTarget - smoothedDistortionWet);
    }

    void clearHeldNotes()
    {
        heldNoteCount = 0;
    }

    void holdNote (int note, int velocity)
    {
        int existing = -1;
        for (int i = 0; i < heldNoteCount; i += 1)
            if (heldNotes.at (i) == note)
                existing = i;

        if (existing >= 0)
        {
            for (int i = existing; i < heldNoteCount - 1; i += 1)
            {
                heldNotes.at (i) = heldNotes.at (i + 1);
                heldVelocities.at (i) = heldVelocities.at (i + 1);
            }
            heldNoteCount -= 1;
        }

        if (heldNoteCount < 128)
        {
            heldNotes.at (heldNoteCount) = note;
            heldVelocities.at (heldNoteCount) = velocity;
            heldNoteCount += 1;
        }
    }

    bool removeHeldNote (int note)
    {
        int existing = -1;
        for (int i = 0; i < heldNoteCount; i += 1)
            if (heldNotes.at (i) == note)
                existing = i;

        if (existing < 0)
            return false;

        for (int i = existing; i < heldNoteCount - 1; i += 1)
        {
            heldNotes.at (i) = heldNotes.at (i + 1);
            heldVelocities.at (i) = heldVelocities.at (i + 1);
        }
        heldNoteCount -= 1;
        return true;
    }

    void triggerNote (int note, bool hasAccent)
    {
        let frequency = midiFrequency (note);
        currentNote = note;
        targetFrequency = frequency;
        currentFrequency = frequency;
        filterEnvelope = 1.0f;
        ampEnvelope = 1.0f;
        accented = hasAccent;
        gateOpen = true;
    }

    void slideToNote (int note, bool hasAccent)
    {
        currentNote = note;
        targetFrequency = midiFrequency (note);
        accented = hasAccent;
        gateOpen = true;
    }

    void releaseNote()
    {
        gateOpen = false;
    }

    float activeTempo()
    {
        return dawSyncEnabled && hostTempoSeen ? hostTempo : tempo;
    }

    bool sequencerRunning()
    {
        // A host that does not send transport events must not leave the instrument
        // dead. DAW mode hands control over as soon as a real transport event
        // arrives; until then RUN/STOP remains a deterministic INT fallback.
        return dawSyncEnabled && hostTransportSeen ? dawPlaying : manualRunning;
    }

    int hostSyncFlags()
    {
        return (hostTempoSeen ? 1 : 0)
             + (hostTransportSeen ? 2 : 0)
             + (hostPositionSeen ? 4 : 0);
    }

    void reportClockState()
    {
        let nextTempo = activeTempo();
        if (abs (nextTempo - reportedTempo) > 0.001f)
        {
            effectiveTempo <- nextTempo;
            reportedTempo = nextTempo;
        }

        let nextRunning = sequencerRunning() ? 1 : 0;
        if (nextRunning != reportedRunning)
        {
            transportRunning <- float (nextRunning);
            reportedRunning = nextRunning;
        }

        let nextSyncFlags = hostSyncFlags();
        if (nextSyncFlags != reportedSyncFlags)
        {
            hostSyncStatus <- float (nextSyncFlags);
            reportedSyncFlags = nextSyncFlags;
        }
    }

    void broadcastClockState()
    {
        let nextTempo = activeTempo();
        let nextRunning = sequencerRunning() ? 1 : 0;
        let nextSyncFlags = hostSyncFlags();
        effectiveTempo <- nextTempo;
        transportRunning <- float (nextRunning);
        hostSyncStatus <- float (nextSyncFlags);
        reportedTempo = nextTempo;
        reportedRunning = nextRunning;
        reportedSyncFlags = nextSyncFlags;
    }

    void acceptHostTempo (float nextTempo)
    {
        let boundedTempo = clamp (nextTempo, 1.0f, 999.0f);
        let changed = ! hostTempoSeen || abs (boundedTempo - hostTempo) > 0.001f;
        hostTempo = boundedTempo;
        hostTempoSeen = true;
        if (dawSyncEnabled)
            tempo = clamp (boundedTempo, 40.0f, 300.0f);
        if (changed)
            reportClockState();
    }

    void acceptHostTransport (bool nextPlaying)
    {
        let changed = ! hostTransportSeen || nextPlaying != dawPlaying;
        hostTransportSeen = true;
        dawPlaying = nextPlaying;
        if (changed && dawSyncEnabled)
            resetSequencer();
        if (changed)
            reportClockState();
    }

    void acceptHostPosition (float64 nextQuarterNote)
    {
        hostQuarterNote = nextQuarterNote;
        if (! hostPositionSeen)
        {
            hostPositionSeen = true;
            reportClockState();
        }
    }

    void resetSequencer()
    {
        clearHeldNotes();
        sequenceStep = -1;
        sequenceCountdown = 0;
        gateCountdown = 0;
        dawTickReady = false;
        dawGateArmed = false;
        currentStep <- -1.0f;
        releaseNote();
    }

    int wrapSequenceStep (int64 absoluteStep)
    {
        let length = int64 (clamp (patternLength, 1, 16));
        var wrapped = int (absoluteStep % length);
        if (wrapped < 0)
            wrapped += int (length);
        return wrapped;
    }

    float64 swingDelayQuarterNote()
    {
        // At 100%, move the second sixteenth to the final triplet division.
        // The pair still spans exactly one eighth note: 2/3 + 1/3.
        return float64 (clamp (swingControl, 0.0f, 100.0f)) / 1200.0;
    }

    float stepDurationQuarterNotes (int step)
    {
        let delay = float (swingDelayQuarterNote());
        return (step & 1) == 0 ? 0.25f + delay : 0.25f - delay;
    }

    void startSequenceStepAt (int nextStep, float sampleRate, float bpm)
    {
        let length = clamp (patternLength, 1, 16);
        let previousFlags = sequenceStep >= 0 ? getFlags (sequenceStep) : 0;
        sequenceStep = clamp (nextStep, 0, length - 1);

        let flags = getFlags (sequenceStep);
        let hasGate = (flags & 1) != 0;
        let hasAccent = (flags & 2) != 0;
        let previousSlide = (previousFlags & 4) != 0;
        let stepDuration = stepDurationQuarterNotes (sequenceStep);
        let stepSamples = max (1, int (sampleRate * 60.0f * stepDuration
                                      / max (bpm, 1.0f) + 0.5f));

        if (hasGate)
        {
            let note = clamp (rootNote + getPitch (sequenceStep), 0, 127);
            if (previousSlide && gateOpen)
                slideToNote (note, hasAccent);
            else
                triggerNote (note, hasAccent);
        }
        else
        {
            releaseNote();
        }

        sequenceCountdown = stepSamples;
        gateCountdown = (flags & 4) != 0 ? stepSamples + 1 : max (1, stepSamples / 2);
        currentStep <- float (sequenceStep);
    }

    void startNextInternalStep (float sampleRate)
    {
        let length = clamp (patternLength, 1, 16);
        var nextStep = sequenceStep + 1;
        if (nextStep >= length)
            nextStep = 0;
        startSequenceStepAt (nextStep, sampleRate, activeTempo());
    }

    void processInternalClock (float sampleRate)
    {
        if (sequenceCountdown <= 0)
            startNextInternalStep (sampleRate);

        sequenceCountdown -= 1;
        gateCountdown -= 1;
        if (gateCountdown == 0)
            releaseNote();
    }

    void processDawClock (float sampleRate)
    {
        let pairIndex = int64 (floor (hostQuarterNote * 2.0));
        let pairStart = float64 (pairIndex) * 0.5;
        let oddStepStart = pairStart + 0.25 + swingDelayQuarterNote();
        let isOddStep = hostQuarterNote >= oddStepStart;
        let absoluteStep = pairIndex * 2 + (isOddStep ? 1 : 0);

        if (! dawTickReady || absoluteStep != lastDawTick)
        {
            startSequenceStepAt (wrapSequenceStep (absoluteStep), sampleRate, activeTempo());
            lastDawTick = absoluteStep;
            dawTickReady = true;

            let flags = getFlags (sequenceStep);
            dawGateArmed = (flags & 1) != 0 && (flags & 4) == 0;
            let stepStart = isOddStep ? oddStepStart : pairStart;
            let stepEnd = isOddStep ? pairStart + 0.5 : oddStepStart;
            dawGateOffQuarterNote = stepStart + (stepEnd - stepStart) * 0.5;
        }

        if (dawGateArmed && hostQuarterNote >= dawGateOffQuarterNote)
        {
            releaseNote();
            dawGateArmed = false;
        }

        hostQuarterNote += float64 (activeTempo() / (60.0f * sampleRate));
    }

    // Topologiehergeleitete Diodenleiter, Zero-Delay-Feedback nach Zavalishins
    // topologieerhaltender Transformation, fuer die Diodenleiter hergeleitet
    // von Pirkle (AN-6). Referenzumsetzung: Faust `vaeffects.diodeLadder` von
    // Eric Tarr, MIT-style STK-4.3, lizenzkompatibel.
    //
    // Ersetzt den Open303-Polynomfit. Der Fit war eine Anpassung an gemessenes
    // Verhalten — „Measured Open303 TB-303 recurrence" stand als Kommentar
    // daneben. Kein Bauteil, kein Knoten, keine Diode.
    //
    // Der Kern ist die Rekursion G4..G1: Jede Stufenverstaerkung haengt von der
    // darunterliegenden ab. DAS ist die fehlende Entkopplung der Diodenleiter,
    // der Punkt, an dem sie sich vom Moog-Transistorstack unterscheidet. Sie
    // wird nicht nachgebildet, sie faellt aus der Topologie an.
    //
    // Schaltplan: C98 = C99 = C100 = 33 nF, aber C101 = 18 nF. Die vier Stufen
    // sind NICHT gleich; der Pol der vierten liegt um 33/18 hoeher. Weder
    // Open303 noch ein generischer ZDF-Diodenleiter bilden das ab.
    //
    // Kein Rueckkopplungs-Hochpass mehr: Die 150 Hz stammten aus Open303 und
    // sind im vermessenen Prototyp nicht enthalten. Er wird hier so eingesetzt,
    // wie er gemessen wurde.
    float processLadder (float signal, float cutoffHz, float sampleRate)
    {
        // Nach dem Schleifenumbau braucht es KEINE Umrechnung mehr: Mit dem
        // Koppelnetz in der Rueckkopplung faellt die hoerbare Resonanzspitze
        // praktisch auf den Modellparameter. Gemessen bei Resonanz 0,72,
        // noetiger Faktor 0,963 / 0,990 / 1,003 / 1,009 bei 300 / 700 / 1500 /
        // 3000 Hz — Abweichung unter einem Halbton ueber vier Oktaven.
        //
        // Vorher stand hier 1,345, kalibriert am Kern OHNE Schleifenkopplung.
        // Nach dem Umbau schob dieser Skalar den Cutoff um 34,5 % zu hoch.
        let bounded = clamp (cutoffHz, 20.0f, min (20000.0f, sampleRate * 0.45f));

        let T  = 1.0 / float64 (sampleRate);
        let wd = float64 (twoPi) * float64 (bounded);
        let wa = (2.0 / T) * tan (wd * T * 0.5);   // bilineare Vorverzerrung
        let g  = wa * T * 0.5;

        // Leiterkondensatoren: C98 = C99 = C100 = 33 nF, C101 = 18 nF.
        //
        // Das sind die SOLLWERTE, und sie sind das Ziel — nicht ein Idealfall.
        // Die Stueckliste nennt +-10 % (`2A333K`, `2A183K`), aber Toleranz ist
        // ein Fertigungsmangel, den die Selektion beseitigen soll, kein Merkmal
        // des Instruments. Eine Streuung zu modellieren hiesse, ein schlechter
        // gefertigtes Geraet zu modellieren.
        //
        // Empfindlichkeit, gemessen (tools/bench/spread, zehn Ziehungen):
        // +-10 % an allen vier Kondensatoren verschieben die Resonanzspitze um
        // **171 Cent** und die Spitzenhoehe um 1,2 dB. Das sagt, wie eng die
        // Bauteile sein muessen — nicht, dass Abweichung hineingehoert.
        //
        // Zum Vergleich die Transistorpaarung, die im Nachbau als kritisch
        // gilt: 0,3 mV Vbe-Differenz sind exp(0,3/26) = 1,16 % Stromabweichung.
        // Die Kondensatoren daneben stehen mit +-10 %. Die Paarung sichert also
        // den Arbeitspunkt der Leiter, nicht die Lage der Eckfrequenzen.
        const float64 cap1 = 33.0, cap2 = 33.0, cap3 = 33.0, cap4 = 18.0;

        let g1 = g * (33.0 / cap1);
        let g2 = g * (33.0 / cap2);
        let g3 = g * (33.0 / cap3);
        let g4 = g * (33.0 / cap4);

        let G4 = 0.5 * g4 / (1.0 + g4);
        let G3 = 0.5 * g3 / (1.0 + g3 - 0.5 * g3 * G4);
        let G2 = 0.5 * g2 / (1.0 + g2 - 0.5 * g2 * G3);
        let G1 =       g1 / (1.0 + g1 -       g1 * G2);

        let bigGamma = G1 * G2 * G3 * G4;

        let SG1 = G4 * G3 * G2;
        let SG2 = G4 * G3;
        let SG3 = G4;

        // VR4 ist ein lineares B-Poti: Rueckkopplung linear ueber den Reglerweg.
        // kMax knapp unter der gemessenen Anschwinggrenze (zwischen 19,4 und
        // 19,6 bei Schaltplan-Kondensatoren). Der Serien-303 schwingt
        // absichtlich NICHT an — ein handverloeteter Widerstand trimmt „just
        // under that required for self-oscillation". Selbstoszillation waere
        // ein Fehler, kein Fortschritt.
        const float64 kMax = 18.7 / 1.06;
        let k = kMax * float64 (clamp (resonanceSkewed, 0.0f, 1.0f));

        let alpha1 = g1 / (1.0 + g1);
        let alpha2 = g2 / (1.0 + g2);
        let alpha3 = g3 / (1.0 + g3);
        let alpha4 = g4 / (1.0 + g4);

        let gam1 = 1.0 + G1 * G2;
        let gam2 = 1.0 + G2 * G3;
        let gam3 = 1.0 + G3 * G4;

        let B1 = 1.0 / (1.0 + g1 -       g1 * G2);
        let B2 = 1.0 / (1.0 + g2 - 0.5 * g2 * G3);
        let B3 = 1.0 / (1.0 + g3 - 0.5 * g3 * G4);
        let B4 = 1.0 / (1.0 + g4);

        let d1 = g1, d2 = 0.5 * g2, d3 = 0.5 * g3;

        // Instantanteil und Zustandsbeitrag beider Kaskaden.
        // Zustandsbeitrag = Summe s_j * Produkt der b0 der NACHFOLGENDEN Glieder,
        // also Horner vorwaerts: acc = acc*b0_j + s_j ueber j = 0..N-1.
        var cInst = 1.0;
        var cState = 0.0;
        for (wrap<5> i)
        {
            cState = cState * coupleB0[i]
                   + (coupleB1[i] * coupleX1[i] - coupleA1[i] * coupleY1[i]);
            cInst *= coupleB0[i];
        }

        var bInst = 1.0;
        var bState = 0.0;
        for (wrap<3> i)
        {
            bState = bState * fbB0[i]
                   + (fbB1[i] * fbX1[i] - fbA1[i] * fbY1[i]);
            bInst *= fbB0[i];
        }
        bInst *= k;
        bState *= k;

        let x = float64 (signal);

        // Zustandsbeitraege, von unten nach oben aufgesammelt.
        let S4 = zdfS4 * B4;
        let S3 = (S4 * d3 + zdfS3) * B3;
        let S2 = (S3 * d2 + zdfS2) * B2;
        let S1 = (S2 * d1 + zdfS1) * B1;

        // Abweichung von der Faust-Vorlage: dort steht fuer die zweite Stufe
        // SG3; der Pfad von Stufe 2 zum Ausgang laeuft aber ueber G3*G4 = SG2.
        let sigma = S1 * SG1 + S2 * SG2 + S3 * SG3 + S4;

        // Aussteuerung der Diodenpaare. Ein Diodenpaar am Ruhestrom
        // I_c kann an die naechste Stufe hoechstens +-I_c weiterreichen; die
        // Uebertragung ist I_c * tanh(v / (2*Vt)). Der Signalstrom kommt ueber
        // R62 = 220 k, der Steuerstrom ist I_c = 2*pi*f_c*C98*2*Vt. Also
        //
        //   drive = I_signal / I_c = (V/220k) / (2*pi*f_c*33n*52mV)
        //
        // Das Verhaeltnis haengt an 1/f_c — die Schwelle ist KEINE Konstante,
        // sondern folgt der Eckfrequenz ueber mehr als eine Groessenordnung.
        // Genau daran ist der fruehere `vSat`-Versuch gescheitert.
        //
        // Der Pegel ist belegt, kein freier Parameter: x0x-VCF-Mods, „The VCO
        // output is from 5.33v to ~10.5v" — beides Absolutwerte auf der
        // 5,333-V-Vorspannung, also 5,17 Vss Hub, ueber C17 wechselstrom-
        // gekoppelt. Der Saegezahn im Modell hat 2,0 Einheiten ss, damit ist
        // eine Modelleinheit 2,585 V Spitze und der Signalstrom 11,75 uA.
        const float64 ladderDriveRef = 1089.8;   // (2,585 V / 220k) / (2*pi*33n*52m)
        let drive = ladderDriveRef / float64 (bounded);

        // WO die Begrenzung sitzt — und wo NICHT.
        //
        // Die begrenzenden Bauteile sind die Diodenpaare ZWISCHEN den
        // Kondensatorebenen. Jedes wird von der Spannung ueber sich getrieben,
        // also von der bereits integrierten Knotenspannung, und reicht
        // I_c * tanh(v/(2*Vt)) weiter. Deshalb steht N auf y1, y2, y3.
        //
        // Am Eingang steht KEINE Begrenzung. Der Zulauf ueber C17/R62 = 220 k
        // ist eine Stromquelle; ein eingepraegter Strom wird von einem
        // Diodenpaar nicht begrenzt, er laeuft in die Knotenkapazitaet und die
        // Knotenspannung stellt sich ein. Begrenzt wird der Eingangsstrom
        // trotzdem — y1 steigt, bis das erste Paar in die Saettigung geht — nur
        // eben nicht augenblicklich auf dem breitbandigen Eingangssignal.
        //
        // Das war zuerst falsch herum gebaut (N auch auf u) und ist an einer
        // Messung aufgeflogen: Ein breitbandiges tanh auf dem rohen Oszillator
        // erzeugt Oberwellen bis weit ueber Nyquist, die zurueckfalten. Bei
        // f_c = 200 Hz und 7011 Hz Eingang lag die groesste inharmonische Linie
        // **+44,3 dB UEBER** dem Nutzsignal. Ohne die Eingangsbegrenzung sind es
        // -62,9 dB — 107 dB besser, und der Klirr steigt dabei sogar leicht
        // (47,6 % statt 42,0 % bei 300 Hz). Die Nichtlinearitaet ist also nicht
        // schwaecher, sie sitzt nur am richtigen Ort. Kein Oversampling noetig.
        //
        // Das OBERE Paar begrenzt ein viertes Mal, auf y4: Stinchcombes d = 1
        // steht in H_tb — das Transistorpaar oben ist Teil der Leiter, der
        // Ausgangsstrom laeuft hindurch (deshalb skaliert sein -d/H mit d).
        // y4 ist das am staerksten gefilterte Signal, Faltung bleibt minimal
        // (Pruefstein 7 wacht darueber).
        //
        // Der Massstab `drive` gilt fuer alle Paare, weil alle am selben
        // Steuerstrom haengen; dass C101 = 18 nF die vierte Ecke verschiebt,
        // steckt in g4 und nicht in der Begrenzung.
        //
        // Die Kette ist bei gegebenem u EXPLIZIT — G/S haben die Rueckwirkung
        // zwischen benachbarten Stufen bereits aufgeloest. Implizit bleibt nur
        // die Resonanzschleife ueber y4, also ein Skalar: Newton auf u.
        //
        // NAEHERUNG, ausdruecklich benannt: gam/G/S stammen aus der LINEAREN
        // Aufloesung dieser Rueckwirkung. Der Vorwaertspfad ist damit exakt
        // nichtlinear, die Belastung einer Stufe durch die folgende bleibt
        // linearisiert. Widerlegbar waere das an einem Geraet, dessen Klirr bei
        // tiefem Cutoff deutlich ueber dem Modell liegt.
        let P = x - bInst * (cInst * sigma + cState) - bState;
        let Q = bInst * cInst * bigGamma;
        let A = bInst * cInst;
        let R = bInst * cState + bState - x;

        // Startwert ist die lineare Loesung — und sie ist im linearen Grenzfall
        // schon exakt: mit N(v) = v wird alpha1*gam1 = G1, 0,5*alpha2*gam2 = G2,
        // 0,5*alpha3*gam3 = G3, 0,5*alpha4 = G4, also dy4/du = bigGamma. Newton
        // ruehrt sich dann nicht. Pruefstein: die Anschwinggrenze darf sich
        // durch diesen Umbau NICHT verschieben.
        //
        // Zwei Schritte, gemessen begruendet: 1, 2, 3 und 6 Iterationen liefern
        // in jedem geprueften Betriebspunkt — auch im Grenzzyklus bei 8 kHz und
        // k = 2*kMax — dasselbe Ergebnis auf acht Nachkommastellen. Grund ist,
        // dass bigGamma im Hoerbereich bei ~3e-6 liegt: der instantane Anteil
        // der Schleife ist winzig, die Resonanz steckt im Zustand. Der zweite
        // Schritt ist Reserve fuer hohe Eckfrequenzen, wo bigGamma waechst.
        var u = P / (1.0 + Q);
        for (wrap<2> newtonStep)
        {
            let y1i = (u * gam1 + S2 + S1 * G2 - zdfS1) * alpha1 + zdfS1;
            let d1i = alpha1 * gam1;

            let t1 = tanh (y1i * drive);
            let y2i = (((t1 / drive) * gam2 + S3 + S2 * G3) * 0.5 - zdfS2) * alpha2 + zdfS2;
            let d2i = alpha2 * 0.5 * gam2 * (1.0 - t1 * t1) * d1i;

            let t2 = tanh (y2i * drive);
            let y3i = (((t2 / drive) * gam3 + S4 + S3 * G4) * 0.5 - zdfS3) * alpha3 + zdfS3;
            let d3i = alpha3 * 0.5 * gam3 * (1.0 - t2 * t2) * d2i;

            let t3 = tanh (y3i * drive);
            let y4i = ((t3 / drive) * 0.5 - zdfS4) * alpha4 + zdfS4;
            let d4i = alpha4 * 0.5 * (1.0 - t3 * t3) * d3i;

            let t4 = tanh (y4i * drive);
            u -= (u + A * (t4 / drive) + R) / (1.0 + A * (1.0 - t4 * t4) * d4i);
        }

        let in1 = u * gam1 + S2 + S1 * G2;
        let v1 = (in1 - zdfS1) * alpha1;
        let y1 = v1 + zdfS1;
        zdfS1 += 2.0 * v1;

        let in2 = tanh (y1 * drive) / drive * gam2 + S3 + S2 * G3;
        let v2 = (in2 * 0.5 - zdfS2) * alpha2;
        let y2 = v2 + zdfS2;
        zdfS2 += 2.0 * v2;

        let in3 = tanh (y2 * drive) / drive * gam3 + S4 + S3 * G4;
        let v3 = (in3 * 0.5 - zdfS3) * alpha3;
        let y3 = v3 + zdfS3;
        zdfS3 += 2.0 * v3;

        let v4 = (tanh (y3 * drive) / drive * 0.5 - zdfS4) * alpha4;
        let y4 = v4 + zdfS4;
        zdfS4 += 2.0 * v4;

        // Koppelnetz nachfuehren (Vorwaertspfad); Ausgang durch das obere Paar.
        var v = tanh (y4 * drive) / drive;
        for (wrap<5> i)
        {
            let y = coupleB0[i] * v + coupleB1[i] * coupleX1[i] - coupleA1[i] * coupleY1[i];
            coupleX1[i] = v;
            coupleY1[i] = y;
            v = y;
        }

        // Rueckkopplungsnetz mit dem Ausgang nachfuehren.
        var w = v;
        for (wrap<3> i)
        {
            let y = fbB0[i] * w + fbB1[i] * fbX1[i] - fbA1[i] * fbY1[i];
            fbX1[i] = w;
            fbY1[i] = y;
            w = y;
        }

        // Hier stand ein Faktor 2. Er ist ersatzlos weg, und das ist belegt,
        // nicht geschaetzt: Stinchcombes L(s) ist
        //
        //   L(s) = s^4/wc^4 + 2^(11/4) s^3/wc^3 + 10*sqrt(2) s^2/wc^2
        //          + 2^(13/4) s/wc + 1
        //
        // also **L(0) = 1**. Bei k = 0 ist H(s) = C(s)/L(s), und C(s) laeuft
        // oberhalb der Koppelecken gegen 1,06. Der Durchlassbereich des ganzen
        // Filters ist damit 1,06 — nicht 2,12.
        //
        // Nachgemessen mit geoeffneter Cutoff-Klemme bei 384 kHz, Signal
        // 1000 Hz, damit die Leiter wirklich flach ist:
        //
        //   f_c =  20 kHz -> Modell/|C| = 1,6834
        //   f_c =  50 kHz -> 1,9432
        //   f_c = 100 kHz -> 1,9904
        //   f_c = 150 kHz -> 1,9987
        //
        // Die Leiter hat also Gleichspannungsverstaerkung 1 wie 1/L(s), und der
        // Faktor 2 war reine Zugabe ohne Gegenstueck in der Uebertragungs-
        // funktion. Damit ist die letzte gemeinsame Unbekannte zu: Der
        // Spannungsmassstab haengt jetzt am belegten VCO-Hub (2,585 V je
        // Modelleinheit), und `otaDrive` faellt daraus ab statt geraten zu sein.
        return float (v);
    }

    // Die beiden Summenzweige am Eingang des VCA (IC15 BA662A, Pin 3), aus dem
    // Serviceplan verfolgt (tools/bench/nettrace.py):
    //
    //   R121 = 220 k  am FESTEN ENDE von VR4  -> resonanzunabhaengig
    //   R122 = 100 k  am SCHLEIFER  von VR4   -> proportional zur Reglerstellung
    //
    // Beide summieren als Leitwerte, das Verhaeltnis ist 220/100 = 2,2. VR4 ist
    // ein lineares B-Poti, die Schleiferspannung also `Signal * Stellung`.
    // Auf den Zweig am festen Ende normiert:
    //
    //   Faktor = 1 + 2,2 * Stellung
    //
    // Der Ausgleich laeuft damit MIT der Resonanz mit, ohne dass er angekoppelt
    // wird — der zweite Potiabgriff erzeugt ihn. Bei Resonanz null ist der
    // Faktor exakt 1: Der Kompensationszweig traegt dann nichts bei. Das ist
    // der Pruefstein, an dem dieses Modell scheitern koennte.
    //
    // Er hebt den Einbruch NICHT auf: Die Kompensation folgt der Stellung
    // linear, der Einbruch der Form 1/(1+k). Zwei verschiedene Gesetze, also
    // bleibt sie teilweise — ein 303 duennt bei hoher Resonanz hoerbar aus.
    // Die beiden Summenzweige am VCA-Eingang tragen je einen eigenen
    // Koppelkondensator, und weil ihre Widerstaende verschieden sind, liegen
    // ihre Hochpassecken verschieden. Gegen den Knotenwiderstand R124 = 2,2 k
    // (C37 als Wechselspannungsmasse):
    //
    //   Filterzweig:  R121 + R124 = 222,2 k  mit C21 = 10 nF ->  71,6 Hz
    //   Comp-Zweig:   R122 + R124 = 102,2 k  mit C22 = 10 nF -> 155,7 Hz
    //
    // Der Kompensationszweig ist in der Schaltung also bassaermer als der
    // Filterzweig. Bei Resonanz null traegt er nichts bei, dann bleibt genau
    // der 71,6-Hz-Hochpass des Filterzweigs stehen.
    void updateVcaBranchCoefficients (float sampleRate)
    {
        let rate = max (float64 (sampleRate), 1.0);
        vcaFiltP = exp (-float64 (twoPi) * 71.6 / rate);
        vcaFiltG = 0.5 * (1.0 + vcaFiltP);
        vcaCompP = exp (-float64 (twoPi) * 155.7 / rate);
        vcaCompG = 0.5 * (1.0 + vcaCompP);
    }

    float vcaSummingNode (float signal)
    {
        let x = float64 (signal);
        let yf = vcaFiltG * (x - vcaFiltX1) + vcaFiltP * vcaFiltY1;
        vcaFiltX1 = x; vcaFiltY1 = yf;
        let yc = vcaCompG * (x - vcaCompX1) + vcaCompP * vcaCompY1;
        vcaCompX1 = x; vcaCompY1 = yc;

        const float64 branchRatio = 2.2;   // R121 / R122 = 220 k / 100 k
        return float (yf + branchRatio * float64 (clamp (resonanceSkewed, 0.0f, 1.0f)) * yc);
    }

    float resonanceCompensation()
    {
        const float branchRatio = 2.2f;
        return 1.0f + branchRatio * clamp (resonanceSkewed, 0.0f, 1.0f);
    }

    // IC15 = BA662A, ein Operational Transconductance Amplifier. Seine
    // Verstaerkung setzt ein Steuerstrom, und die Eingangs-Differenzstufe ist
    // bipolar — die Kennlinie ist damit
    //
    //   I_aus = I_abc * tanh (v_ein / (2 * Vt)),   2*Vt = 52 mV bei Raumtemp.
    //
    // Der Steuerstrom bleibt der bisherige `ampControl`-Pfad. Neu ist die
    // Kennlinie: ACIDIFY hat bisher schlicht multipliziert.
    //
    // Aussteuerung am Eingang: Der Summenknoten liegt ueber `R124 = 2,2 k`
    // (mit C37 als Wechselspannungsmasse) an der Referenz, die Zweige kommen
    // ueber `R121 = 220 k`. Der Knoten teilt also auf 2,2/220 = 1/100 herunter
    // — genau das haelt den OTA im quasilinearen Bereich.
    //
    // FRUEHER OFFEN, JETZT BELEGT. Hier stand die Annahme, Vollaussteuerung
    // entspreche 1 V Spitze am Poti — die Groessenordnung, bei der die
    // BA662-Literatur merkliche Verzerrung nennt. Geraten war daran der
    // Spannungsmassstab. Der steht inzwischen fest:
    //
    //   VCO-Hub 10,5 − 5,33 = 5,17 Vss (x0x-VCF-Mods) auf 2,0 Modelleinheiten
    //   ss  ->  1 Modelleinheit = 2,585 V Spitze
    //
    // und weil der Faktor 2 am Filterausgang entfallen ist (Stinchcombe:
    // L(0) = 1, Durchlassbereich 1,06), gilt derselbe Massstab durchgehend bis
    // zum Summenknoten. Kein freier Parameter mehr in dieser Stufe.
    const float otaDrive = 0.4971f;   // (2,2/220) * 2,585 V / 52 mV

    float processOta (float signal)
    {
        // Beide Summenzweige liegen am selben Eingang, der Kompensationszweig
        // steuert den OTA also mit aus.
        //
        // WIDERLEGT: Ich hatte daraus vorhergesagt, die Kennlinie kruemme sich
        // bei hoher Resonanz staerker. Gemessen ist es umgekehrt — die
        // Kompression ist bei Resonanz NULL am groessten und faellt zu voller
        // Resonanz ab. Nachgemessen mit dem neuen Spannungsmassstab, Cutoff 0,7,
        // Note 36, gegen denselben Lauf mit linearer Stufe:
        // -0,39 dB / -0,18 dB / -0,19 dB bei Resonanz 0 / 0,5 / 1,0.
        // Grund: `signal` selbst
        // bricht mit der Resonanz um mehr ein, als der Faktor (1 + 2,2 r)
        // hinzufuegt. Das Produkt — und nur das steuert den OTA aus — sinkt.
        // Die Topologie ist davon unberuehrt; falsch war der Zusatzschluss.
        let x = vcaSummingNode (signal) * otaDrive;
        return float (tanh (float64 (x))) / otaDrive;
    }

    event param1 (float v)
    {
        tuning = clamp (v, -1.0f, 1.0f);
        if (currentNote >= 0)
            targetFrequency = midiFrequency (currentNote);
    }
    event param2 (float v) { cutoffControl = clamp (v, 0.0f, 1.0f); updateFilterMapping(); }
    event param3 (float v) { resonanceControl = clamp (v, 0.0f, 1.0f); updateResonanceMapping(); }
    event param4 (float v) { envModControl = clamp (v, 0.0f, 1.0f); updateFilterMapping(); }
    event param5 (float v) { decayControl = clamp (v, 0.0f, 1.0f); updateDecayMapping(); }
    event param6 (float v) { accentControl = clamp (v, 0.0f, 1.0f); }
    event param7 (float v) { waveform = int (clamp (v, 0.0f, 1.0f)); }
    event param8 (float v)
    {
        volumeDb = clamp (v, -36.0f, 0.0f);
        outputGainTarget = float (std::levels::dBtoGain (float64 (volumeDb)));
    }
    event param9 (float v)
    {
        tempo = clamp (v, 40.0f, 300.0f);
        reportClockState();
    }
    event param10 (float v)
    {
        let nextRunning = v >= 0.5f;
        if (nextRunning != manualRunning)
        {
            manualRunning = nextRunning;
            if (! dawSyncEnabled || ! hostTransportSeen)
                resetSequencer();
        }
        reportClockState();
    }
    event param11 (float v) { patternLength = int (clamp (v, 1.0f, 16.0f)); }
    event param12 (float v) { rootNote = int (clamp (v, 24.0f, 60.0f)); }

    event param13 (float v) { pitch01 = int (clamp (v, 0.0f, 24.0f)); }
    event param14 (float v) { pitch02 = int (clamp (v, 0.0f, 24.0f)); }
    event param15 (float v) { pitch03 = int (clamp (v, 0.0f, 24.0f)); }
    event param16 (float v) { pitch04 = int (clamp (v, 0.0f, 24.0f)); }
    event param17 (float v) { pitch05 = int (clamp (v, 0.0f, 24.0f)); }
    event param18 (float v) { pitch06 = int (clamp (v, 0.0f, 24.0f)); }
    event param19 (float v) { pitch07 = int (clamp (v, 0.0f, 24.0f)); }
    event param20 (float v) { pitch08 = int (clamp (v, 0.0f, 24.0f)); }
    event param21 (float v) { pitch09 = int (clamp (v, 0.0f, 24.0f)); }
    event param22 (float v) { pitch10 = int (clamp (v, 0.0f, 24.0f)); }
    event param23 (float v) { pitch11 = int (clamp (v, 0.0f, 24.0f)); }
    event param24 (float v) { pitch12 = int (clamp (v, 0.0f, 24.0f)); }
    event param25 (float v) { pitch13 = int (clamp (v, 0.0f, 24.0f)); }
    event param26 (float v) { pitch14 = int (clamp (v, 0.0f, 24.0f)); }
    event param27 (float v) { pitch15 = int (clamp (v, 0.0f, 24.0f)); }
    event param28 (float v) { pitch16 = int (clamp (v, 0.0f, 24.0f)); }

    event param29 (float v) { flags01 = int (clamp (v, 0.0f, 7.0f)); }
    event param30 (float v) { flags02 = int (clamp (v, 0.0f, 7.0f)); }
    event param31 (float v) { flags03 = int (clamp (v, 0.0f, 7.0f)); }
    event param32 (float v) { flags04 = int (clamp (v, 0.0f, 7.0f)); }
    event param33 (float v) { flags05 = int (clamp (v, 0.0f, 7.0f)); }
    event param34 (float v) { flags06 = int (clamp (v, 0.0f, 7.0f)); }
    event param35 (float v) { flags07 = int (clamp (v, 0.0f, 7.0f)); }
    event param36 (float v) { flags08 = int (clamp (v, 0.0f, 7.0f)); }
    event param37 (float v) { flags09 = int (clamp (v, 0.0f, 7.0f)); }
    event param38 (float v) { flags10 = int (clamp (v, 0.0f, 7.0f)); }
    event param39 (float v) { flags11 = int (clamp (v, 0.0f, 7.0f)); }
    event param40 (float v) { flags12 = int (clamp (v, 0.0f, 7.0f)); }
    event param41 (float v) { flags13 = int (clamp (v, 0.0f, 7.0f)); }
    event param42 (float v) { flags14 = int (clamp (v, 0.0f, 7.0f)); }
    event param43 (float v) { flags15 = int (clamp (v, 0.0f, 7.0f)); }
    event param44 (float v) { flags16 = int (clamp (v, 0.0f, 7.0f)); }
    event param45 (float v) { distortionEnabled = v >= 0.5f; }
    event param46 (float v) { distortionType = int (clamp (v, 0.0f, 2.0f)); }
    event param47 (float v) { distortionDrive = clamp (v, 0.0f, 1.0f); }
    event param48 (float v) { distortionMix = clamp (v, 0.0f, 1.0f); }
    event param49 (float v)
    {
        let nextMode = v >= 0.5f;
        if (nextMode != dawSyncEnabled)
        {
            if (! nextMode && hostTempoSeen)
                tempo = clamp (hostTempo, 40.0f, 300.0f);
            dawSyncEnabled = nextMode;
            resetSequencer();
        }
        reportClockState();
    }
    event param50 (float v) { swingControl = clamp (v, 0.0f, 100.0f); }

    // Amorph sends its DAW playhead as a rolling six-value float64 event stream:
    // play state, BPM, time-signature numerator, denominator, absolute PPQ, and
    // one reserved slot. The small learner preserves compatibility with runtimes
    // that place the binary play and tempo values in different slots.
    event transportIn (float64 v)
    {
        int slot = amorphTransportSlot;
        let isBinary = (abs (v) < 0.0001 || abs (v - 1.0) < 0.0001) ? 1.0 : 0.0;
        let isTempo = (v >= 20.0 && v <= 300.0) ? 1.0 : 0.0;
        amorphPlaySlotScore.at (slot) =
            amorphPlaySlotScore.at (slot) * 0.98 + isBinary;
        amorphTempoSlotScore.at (slot) =
            amorphTempoSlotScore.at (slot) * 0.98 + isTempo;

        if (slot == amorphTempoSlot)
            acceptHostTempo (float (clamp (v, 20.0, 300.0)));
        if (slot == amorphPlaySlot)
            acceptHostTransport (abs (v - 1.0) < 0.0001);
        if (slot == 4 && v >= 0.0 && v < 1.0e9)
            acceptHostPosition (v);

        amorphTransportSlot = (amorphTransportSlot + 1) % 6;
        if (amorphTransportSlot == 0)
        {
            int bestPlay = 0;
            float64 bestPlayScore = -1.0;
            for (int candidate = 0; candidate < 6; candidate += 1)
                if (amorphPlaySlotScore.at (candidate) > bestPlayScore)
                {
                    bestPlayScore = amorphPlaySlotScore.at (candidate);
                    bestPlay = candidate;
                }
            amorphPlaySlot = bestPlay;

            int bestTempo = 1;
            float64 bestTempoScore = -1.0;
            for (int candidate = 0; candidate < 6; candidate += 1)
                if (candidate != amorphPlaySlot
                    && amorphTempoSlotScore.at (candidate) > bestTempoScore)
                {
                    bestTempoScore = amorphTempoSlotScore.at (candidate);
                    bestTempo = candidate;
                }
            amorphTempoSlot = bestTempo;
        }
    }

    event tempoIn (std::timeline::Tempo newTempo)
    {
        acceptHostTempo (newTempo.bpm);
    }

    event transportStateIn (std::timeline::TransportState newState)
    {
        acceptHostTransport (newState.isPlaying());
    }

    event positionIn (std::timeline::Position newPosition)
    {
        acceptHostPosition (newPosition.quarterNote);
    }

    event midiIn (std::midi::Message message)
    {
        if (sequencerRunning())
            return;

        if (message.isControllerNumber (120) || message.isControllerNumber (123))
        {
            clearHeldNotes();
            releaseNote();
        }
        else if (message.isNoteOn())
        {
            let note = message.getNoteNumber();
            let velocity = message.getVelocity();
            let hasAccent = velocity >= 100;
            let wasHoldingNotes = heldNoteCount > 0;
            holdNote (note, velocity);
            if (wasHoldingNotes && gateOpen)
                slideToNote (note, hasAccent);
            else
                triggerNote (note, hasAccent);
        }
        else if (message.isNoteOff())
        {
            let note = message.getNoteNumber();
            let releasedCurrent = note == currentNote;
            if (removeHeldNote (note) && releasedCurrent)
            {
                if (heldNoteCount > 0)
                {
                    let previousIndex = heldNoteCount - 1;
                    slideToNote (heldNotes.at (previousIndex),
                                 heldVelocities.at (previousIndex) >= 100);
                }
                else
                {
                    releaseNote();
                }
            }
        }
    }

    void main()
    {
        // The working Amorph transport protocol normally uses slot 0 for play
        // and slot 1 for BPM. Bias the learner toward that known startup layout.
        amorphPlaySlotScore.at (0) = 8.0;
        amorphTempoSlotScore.at (1) = 8.0;

        loop
        {
            let sampleRate = float (processor.frequency);

            if (! modelReady)
                initialiseModel (sampleRate);
            else if (abs (sampleRate - cachedRate) > 0.5f)
                updateRateConstants (sampleRate);

            smoothParameters();

            if (sequencerRunning())
            {
                if (dawSyncEnabled && hostPositionSeen)
                    processDawClock (sampleRate);
                else
                    processInternalClock (sampleRate);
            }

            currentFrequency = targetFrequency + glideCoeff * (currentFrequency - targetFrequency);
            let phaseIncrement = clamp (currentFrequency / sampleRate, 0.0f, 0.45f);
            phase += float64 (phaseIncrement);
            if (phase >= 1.0)
                phase -= 1.0;

            let phaseValue = float (phase);
            let saw = phaseValue + phaseValue - 1.0f - polyBlep (phaseValue, phaseIncrement);

            // The stock square is derived from the saw comparator rather than
            // generated by an independent oscillator. Open303's measured
            // shaper constants imply a 46.88% transition point and half level.
            // Der 303 hat ZWEI getrennte Abgriffe, keinen aus dem Saegezahn
            // abgeleiteten Komparator: Rechteck an R36/Q8, Saegezahn an
            // R105/Q28 (x0x-VCF-Mods-Seite, „Take the feed from the square wave
            // (R36/Q8) and the saw wave (R105/Q28)").
            //
            // BEWUSST NICHT ERSETZT. Der Wert stammt aus einer Messung an einem
            // echten 303 (Open303), nicht aus einem Modellkompromiss. Ihn durch
            // eine Herleitung aus unbestimmten Komparatorschwellen zu ersetzen
            // waere ein Rueckschritt: gemessene Hardware schlaegt geschaetzte
            // Schaltung. Der VCO-Umbau selbst braucht ausserdem eine eigene
            // Antialiasing-Strategie, der PolyBLEP hier ist antialiasiert.
            const float squareDuty = 0.4687857f;
            float square303 = phaseValue < squareDuty ? 1.0f : -1.0f;
            square303 += polyBlep (phaseValue, phaseIncrement);
            var squareEdge = phaseValue - squareDuty;
            if (squareEdge < 0.0f)
                squareEdge += 1.0f;
            square303 -= polyBlep (squareEdge, phaseIncrement);
            square303 *= 0.5f;
            let oscillator = saw + (square303 - saw) * waveformBlend;

            // Der frueher hier stehende 44,486-Hz-Vorhochpass entfaellt: Er war
            // Open303s Modell der Eingangskopplung, und Stinchcombes C(s) deckt
            // alle fuenf Koppelgruppen ab. Beide zusammen wuerden doppeln.
            // Der Kern ist linear, die Reihenfolge im Signalweg also gleichgueltig.
            let preFiltered = oscillator;

            filterEnvelope *= accented ? accentDecayCoeff : normalDecayCoeff;
            filterEnvelopeRC += filterAttackAlpha * (filterEnvelope - filterEnvelopeRC);

            let exponent = envScaler * (filterEnvelopeRC - envOffset)
                         + processAccentSweep (accented && gateOpen
                                                ? accentControl * filterEnvelope
                                                : 0.0f,
                                               sampleRate);
            let instantaneousCutoff = baseCutoff * float (pow (2.0, float64 (exponent)));
            let filtered = processLadder (preFiltered, instantaneousCutoff, sampleRate);

            // Koppelnetz liegt jetzt IN der Resonanzschleife, wie in der Schaltung.
            let coupled = filtered;

            if (gateOpen)
            {
                ampEnvelope *= ampBodyCoeff;
            }
            else
            {
                ampEnvelope *= accented ? ampAccentReleaseCoeff : ampReleaseCoeff;
            }

            var ampControl = ampEnvelope;
            if (gateOpen)
            {
                let accentVcaSource = accented ? accentControl * filterEnvelope : 0.0f;
                let aAlpha = accentVcaSource > accentVcaRC ? accentVcaRiseAlpha
                                                           : accentVcaFallAlpha;
                accentVcaRC += aAlpha * (accentVcaSource - accentVcaRC);
                // Verfolgt: Der MEG-Knoten laeuft von IC12A ueber Q41 zu VR5
                // (Env Mod) und erreicht den VCA-Steuerknoten NICHT — die
                // Filterhuellkurve speist den VCA in der Schaltung nicht.
                // Der Term `0.45f * filterEnvelope` hatte damit kein Bauteil
                // hinter sich und ist entfallen.
                //
                // Der Accent dagegen speist ueber D35/R133 = 2,2 k in den
                // Q31-Knoten (R131 = 220 k traegt die Huellkurve). Die
                // Stromquellen-Hypothese fuer Q36 ist am Schaltbild WIDERLEGT
                // (Emitter direkt an +12 V, R145 am Kollektor), und ein
                // oeffentliches Netz existiert nicht (EAGLE: nur Werte;
                // RE-303: "no schematic, no netlist"). Die 4.0 kommt aus
                // Open303 — rosic_Open303.h: (0.45 + 4*accentGain)*mainEnvOut —
                // und ist dort gegen Aufnahmen eines echten 303 kalibriert.
                // Damit gilt derselbe Status wie fuer squareDuty: gemessene
                // Hardware schlaegt geschaetzte Schaltung. BEWUSST BEHALTEN.
                ampControl += 4.0f * accentVcaRC;
            }
            else
            {
                accentVcaRC += accentVcaFallAlpha * (0.0f - accentVcaRC);
            }
            ampControl = processAmpSmoother (max (ampControl, 0.0f));

            // Zwei Summenzweige am VCA-Eingang statt einer Verstaerkung im
            // Filter. Der Skalar 0.42f bleibt unveraendert stehen — er gehoert
            // zur Ausgangsstufe und wird erst mit der OTA-Kennlinie ersetzt.
            let vcaInput = processOta (coupled);
            // VCA-Verstaerkung aus Bauteilwerten statt aus einem Fit.
            //
            // Pinbelegung BA662 (Roland-100M-Servicehandbuch): Pin 1 = CV1,
            // Pin 3 = +IN1, Pin 6 = OUT1, Pin 8 = OUT2. Q31 (PNP) ist die
            // Steuerstromquelle an Pin 1, Emitterwiderstand R131 = 220 k
            // nach +12 V:
            //
            //   I_abc,max = (12 V - 0,2 V - 0,6 V) / 220 k = 50,9 uA
            //
            // Der OTA liefert I_aus = I_abc * tanh(v_ein / (2 Vt)); die
            // Ausgangsstufe setzt das ueber R119 = 47 k in Spannung um. Mit dem
            // Eingangsteiler R124/R121 = 1/100 ergibt die Kleinsignal-
            // verstaerkung
            //
            //   I_abc * R119 * (R124/R121) / (2 Vt)
            //     = 50,9 uA * 47 k * 0,01 / 0,052 = 0,460
            //
            // Der Spannungsmassstab kuerzt sich hier heraus — er bleibt nur in
            // otaDrive stehen, das den Knick der Kennlinie setzt.
            // Open303 stand hier mit 0,42; die Herleitung liegt 9,6 % darueber.
            const float vcaGain = 0.4601f;
            let cleanVoice = vcaInput * ampControl * vcaGain * outputGain;
            let voice = processDistortion (cleanVoice);
            let sample = abs (voice) < 0.0000000001f ? 0.0f : voice;

            meterEnvelope += meterAlpha * (abs (sample) - meterEnvelope);
            meterCountdown -= 1;
            if (meterCountdown <= 0)
            {
                meterOut <- clamp (meterEnvelope * 2.0f, 0.0f, 1.0f);
                meterCountdown = meterPeriod;
            }

            clockReportCountdown -= 1;
            if (clockReportCountdown <= 0)
            {
                broadcastClockState();
                clockReportCountdown = clockReportPeriod;
            }

            out <- float<2> (sample, sample);
            advance();
        }
    }
}

graph Acidify [[ main ]]
{
    input  event std::midi::Message midiIn;
    input  event float64 transportIn;
    input  event std::timeline::Tempo tempoIn;
    input  event std::timeline::TransportState transportStateIn;
    input  event std::timeline::Position positionIn;
    output stream float<2> out;
    output event float currentStep;
    output event float meterOut;
    output event float effectiveTempo;
    output event float transportRunning;
    output event float hostSyncStatus;

    input event float param1  [[ name: "Tuning",         min: -1.0, max: 1.0,   init: 0.0,   unit: "st" ]];
    input event float param2  [[ name: "Cut Off Freq",   min: 0.0,  max: 1.0,   init: 0.45 ]];
    input event float param3  [[ name: "Resonance",      min: 0.0,  max: 1.0,   init: 0.72 ]];
    input event float param4  [[ name: "Env Mod",        min: 0.0,  max: 1.0,   init: 0.68 ]];
    input event float param5  [[ name: "Decay",          min: 0.0,  max: 1.0,   init: 0.45 ]];
    input event float param6  [[ name: "Accent",         min: 0.0,  max: 1.0,   init: 0.65 ]];
    input event float param7  [[ name: "Waveform",       min: 0.0,  max: 1.0,   init: 0.0,   step: 1.0 ]];
    input event float param8  [[ name: "Volume",         min: -36.0, max: 0.0,  init: -6.0,  unit: "dB" ]];
    input event float param9  [[ name: "Tempo",          min: 40.0, max: 300.0, init: 128.0, step: 0.01, unit: "bpm" ]];
    input event float param10 [[ name: "Run",            min: 0.0,  max: 1.0,   init: 0.0,   step: 1.0 ]];
    input event float param11 [[ name: "Pattern Length", min: 1.0,  max: 16.0,  init: 16.0,  step: 1.0 ]];
    input event float param12 [[ name: "Root Note",      min: 24.0, max: 60.0,  init: 36.0,  step: 1.0 ]];

    input event float param13 [[ name: "Step 01 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param14 [[ name: "Step 02 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param15 [[ name: "Step 03 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param16 [[ name: "Step 04 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param17 [[ name: "Step 05 Pitch", min: 0.0, max: 24.0, init: 12.0, step: 1.0 ]];
    input event float param18 [[ name: "Step 06 Pitch", min: 0.0, max: 24.0, init: 10.0, step: 1.0 ]];
    input event float param19 [[ name: "Step 07 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param20 [[ name: "Step 08 Pitch", min: 0.0, max: 24.0, init: 3.0,  step: 1.0 ]];
    input event float param21 [[ name: "Step 09 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param22 [[ name: "Step 10 Pitch", min: 0.0, max: 24.0, init: 0.0,  step: 1.0 ]];
    input event float param23 [[ name: "Step 11 Pitch", min: 0.0, max: 24.0, init: 12.0, step: 1.0 ]];
    input event float param24 [[ name: "Step 12 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];
    input event float param25 [[ name: "Step 13 Pitch", min: 0.0, max: 24.0, init: 10.0, step: 1.0 ]];
    input event float param26 [[ name: "Step 14 Pitch", min: 0.0, max: 24.0, init: 5.0,  step: 1.0 ]];
    input event float param27 [[ name: "Step 15 Pitch", min: 0.0, max: 24.0, init: 3.0,  step: 1.0 ]];
    input event float param28 [[ name: "Step 16 Pitch", min: 0.0, max: 24.0, init: 7.0,  step: 1.0 ]];

    input event float param29 [[ name: "Step 01 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param30 [[ name: "Step 02 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param31 [[ name: "Step 03 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param32 [[ name: "Step 04 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param33 [[ name: "Step 05 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param34 [[ name: "Step 06 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param35 [[ name: "Step 07 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param36 [[ name: "Step 08 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param37 [[ name: "Step 09 Flags", min: 0.0, max: 7.0, init: 0.0, step: 1.0 ]];
    input event float param38 [[ name: "Step 10 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param39 [[ name: "Step 11 Flags", min: 0.0, max: 7.0, init: 3.0, step: 1.0 ]];
    input event float param40 [[ name: "Step 12 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param41 [[ name: "Step 13 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param42 [[ name: "Step 14 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param43 [[ name: "Step 15 Flags", min: 0.0, max: 7.0, init: 1.0, step: 1.0 ]];
    input event float param44 [[ name: "Step 16 Flags", min: 0.0, max: 7.0, init: 5.0, step: 1.0 ]];
    input event float param45 [[ name: "Distortion Enable", min: 0.0, max: 1.0, init: 0.0, step: 1.0 ]];
    input event float param46 [[ name: "Distortion Type",   min: 0.0, max: 2.0, init: 0.0, step: 1.0 ]];
    input event float param47 [[ name: "Distortion Drive",  min: 0.0, max: 1.0, init: 0.35 ]];
    input event float param48 [[ name: "Distortion Mix",    min: 0.0, max: 1.0, init: 1.0 ]];
    input event float param49 [[ name: "Clock Mode",         min: 0.0, max: 1.0, init: 0.0, step: 1.0,
                                 text: "Internal|DAW" ]];
    input event float param50 [[ name: "Swing",              min: 0.0, max: 100.0, init: 0.0, step: 1.0,
                                 unit: "%" ]];

    node core = AcidifyCore * 4;

    connection
    {
        midiIn -> core.midiIn;
        transportIn -> core.transportIn;
        tempoIn -> core.tempoIn;
        transportStateIn -> core.transportStateIn;
        positionIn -> core.positionIn;
        core.out -> out;
        core.currentStep -> currentStep;
        core.meterOut -> meterOut;
        core.effectiveTempo -> effectiveTempo;
        core.transportRunning -> transportRunning;
        core.hostSyncStatus -> hostSyncStatus;

        param1 -> core.param1;   param2 -> core.param2;
        param3 -> core.param3;   param4 -> core.param4;
        param5 -> core.param5;   param6 -> core.param6;
        param7 -> core.param7;   param8 -> core.param8;
        param9 -> core.param9;   param10 -> core.param10;
        param11 -> core.param11; param12 -> core.param12;

        param13 -> core.param13; param14 -> core.param14;
        param15 -> core.param15; param16 -> core.param16;
        param17 -> core.param17; param18 -> core.param18;
        param19 -> core.param19; param20 -> core.param20;
        param21 -> core.param21; param22 -> core.param22;
        param23 -> core.param23; param24 -> core.param24;
        param25 -> core.param25; param26 -> core.param26;
        param27 -> core.param27; param28 -> core.param28;

        param29 -> core.param29; param30 -> core.param30;
        param31 -> core.param31; param32 -> core.param32;
        param33 -> core.param33; param34 -> core.param34;
        param35 -> core.param35; param36 -> core.param36;
        param37 -> core.param37; param38 -> core.param38;
        param39 -> core.param39; param40 -> core.param40;
        param41 -> core.param41; param42 -> core.param42;
        param43 -> core.param43; param44 -> core.param44;
        param45 -> core.param45; param46 -> core.param46;
        param47 -> core.param47; param48 -> core.param48;
        param49 -> core.param49;
        param50 -> core.param50;
    }
}
