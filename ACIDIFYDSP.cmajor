/*
    ▄▀█ █▀▀ █ █▀▄ █ █▀▀ █▄█
    █▀█ █▄▄ █ █▄▀ █ █▀░ ░█░      AC-303 BASSLINE SYNTHESIZER

    Author: Clark Parker

    Built from the schematics, not from samples. The diode ladder is
    rebuilt node by node as a zero-delay-feedback model — every stage,
    every diode, the coupling network inside the resonance loop, the
    BA662 OTA, the accent-sweep capacitor and the envelope-modulation
    bias trick straight from the Roland service notes. Slides glide in
    the CV domain. The whole core runs 4x oversampled behind a 16-step
    sequencer, a 16-figure arpeggiator with a 90-phrase acid bank, and
    three loudness-matched drive stages.

    Source of truth: the TB-303 service schematics (docs/reference/).
    Every derived behaviour is guarded by a failing test — see
    tools/dsp_hardware_test.mjs and docs/SOUND_GAP_ANALYSIS.md.
    Third-party attribution (Airwindows drive ports, cited hardware
    measurements): THIRD_PARTY_NOTICES.md.

    Turn the resonance up.
*/

processor AcidifyCore
{
    input  event std::midi::Message midiIn;
    input  event float64 transportIn;
    input  event std::timeline::Tempo tempoIn;
    input  event std::timeline::TransportState transportStateIn;
    input  event std::timeline::Position positionIn;
    output stream float<2> out;
    output event float currentStep;
    output event float meterOut;
    output event float effectiveTempo;
    output event float transportRunning;
    output event float hostSyncStatus;
    output event float arpNoteOut;

    input event float param1  [[ name: "Tuning",         min: -1.0, max: 1.0,   init: 0.0,   unit: "st" ]];
    input event float param2  [[ name: "Cut Off Freq",   min: 0.0,  max: 1.0,   init: 0.45 ]];
