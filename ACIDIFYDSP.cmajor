    // vergleichen kann.
    bool  modOdEnabled = false;      // DF Filter Overdrive (R62 220k -> 3,3k)
    float modOdAmount = 0.3f;        //   Faktor = 66,6^v, also 1..66,6
    bool  modResoBoost = false;      // x0x: R97 10k -> 8,2k => k * 1,2195
    bool  modCutoffExt = false;      // DF: Cutoff-Maximum 5 kHz statt 2,5 kHz
